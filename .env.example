# ---------------------------------------------------------------------------
# SIH26183 - copy to .env and fill in.  NEVER commit the real .env.
# The stack runs fully without any blockchain API key: leave them blank and
# DEMO_MODE=true serves the synthetic fraud-ring dataset instead.
# ---------------------------------------------------------------------------

# --- Host ports -------------------------------------------------------------
# Non-default block so this stack can run alongside another local project that
# holds the conventional ports (5432/7474/7687/6379/8000/5173).
POSTGRES_PORT=5434
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688
REDIS_PORT=6380
BACKEND_PORT=8001
FRONTEND_PORT=5174
# Caddy's TLS front door - the whole stack on one https origin.
# Open https://localhost:8443 rather than the two plaintext ports above.
HTTPS_PORT=8443

# --- Datastores -------------------------------------------------------------
POSTGRES_PASSWORD=sihdev
NEO4J_PASSWORD=sihdevpass

# --- Auth -------------------------------------------------------------------
# Simplified JWT with role claims (see README "Assumptions").
# The value below is the shipped placeholder. With DEMO_MODE=false the backend
# REFUSES TO START until it is replaced - a known signing key would let anyone
# mint a supervisor token and approve a freeze. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=insecure-demo-secret-replace-before-any-real-deployment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Demonstration accounts with published passwords ("investigator"/"supervisor")
# and the /auth/seed-demo-users endpoint that creates them.
# MUST be false in any real deployment - with it on, anyone who can reach the
# API can create themselves a supervisor and approve a freeze. Setting
# DEMO_MODE=false force-disables it regardless of this value.
ALLOW_DEMO_AUTH=true

# --- Demo / honesty switch --------------------------------------------------
# true  -> blockchain connectors serve SYNTHETIC data; UI shows a permanent
#          "SYNTHETIC DEMO DATA" banner.
# false -> connectors call the live indexer APIs below (keys required).
DEMO_MODE=true

# --- Blockchain indexer APIs (all optional) ---------------------------------
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
BLOCKCHAIR_API_KEY=

# --- Tracing defaults -------------------------------------------------------
TRACE_MAX_DEPTH=8
TRACE_MAX_BREADTH=25

# --- Risk scoring -----------------------------------------------------------
# Half-life in days for the time-decay on fraud-linkage aggregation.
RISK_DECAY_HALF_LIFE_DAYS=90
RISK_MEDIUM_THRESHOLD=40
RISK_HIGH_THRESHOLD=70

# --- Rate limiting ----------------------------------------------------------
# The general ceiling stops scripted abuse; it sits well above what the
# dashboard or scripts/e2e_demo.py generate. The auth limit counts FAILED
# sign-ins only, so demonstrating repeated logins never locks anyone out.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_AUTH_FAILURES=8
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
